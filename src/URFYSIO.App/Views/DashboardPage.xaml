<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:URFYSIO.App.ViewModels"
             x:Class="URFYSIO.App.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Logout"
                     Command="{Binding LogoutCommand, Source={x:Static vm:AppShellViewModel.Instance}}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="20">

            <Label Text="{Binding WelcomeMessage}" FontSize="24" FontAttributes="Bold" />
            <Border BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 8" Padding="10" Stroke="{x:Null}">
                <Label Text="{Binding RoleBadge}" TextColor="White" FontSize="12"
                       HorizontalOptions="Start" />
            </Border>

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}" FontSize="12"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />
            <Label Text="{Binding SuccessMessage}"
                   TextColor="{StaticResource Success}"
                   FontSize="14"
                   IsVisible="{Binding SuccessMessage, Converter={StaticResource IsNotNullConverter}}"
                   Margin="0,5" />

            <Label Text="Upcoming Appointments" FontSize="18" FontAttributes="Bold" Margin="0,10,0,0" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <CollectionView ItemsSource="{Binding UpcomingAppointments}"
                            EmptyView="No upcoming appointments.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:Object">
                        <Border Margin="0,5" Padding="12" StrokeShape="RoundRectangle 8">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding StartTime, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding PhysiotherapistName, StringFormat='Physio: {0}'}"
                                       FontSize="13" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="{Binding Notes}" FontSize="12"
                                       TextColor="{StaticResource TextMuted}"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!--
                Current Treatment Plan card — Client view only. Shows the most-recent
                non-completed plan with a 3-entry preview; physios/admins never see this
                because the VM only populates ActivePlan when user.Role == Client.
            -->
            <Label Text="Current Treatment Plan" FontSize="18" FontAttributes="Bold"
                   Margin="0,15,0,0" IsVisible="{Binding IsClient}" />

            <Border IsVisible="{Binding HasActivePlan}"
                    Padding="15" StrokeShape="RoundRectangle 8"
                    Stroke="{StaticResource Primary}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding ActivePlanTitle}" FontAttributes="Bold" FontSize="16" />

                    <!-- Bullet preview of first 3 entries. EmptyView for the rare plan
                         that has zero entries (newly created, physio hasn't filled it in). -->
                    <CollectionView ItemsSource="{Binding ActivePlanEntries}"
                                    EmptyView="No exercises in this plan yet.">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:Object">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2">
                                    <Label Grid.Column="0" Text="•" FontSize="14"
                                           VerticalOptions="Center"
                                           TextColor="{StaticResource Primary}" />
                                    <Label Grid.Column="1" Text="{Binding Title}"
                                           FontSize="14" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Text="View full plan" Command="{Binding ViewFullPlanCommand}"
                            HorizontalOptions="Start" FontSize="13"
                            BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
                            Padding="0" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- "No active plan" state — only shows for clients with no active plans. -->
            <Border IsVisible="{Binding ShowNoPlanMessage}"
                    Padding="15" StrokeShape="RoundRectangle 8"
                    BackgroundColor="{StaticResource SurfaceBackground}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="No active treatment plan" FontAttributes="Bold" FontSize="14" />
                    <Label Text="Your physiotherapist will set up a plan after your first visit."
                           FontSize="12" TextColor="{StaticResource TextMuted}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
