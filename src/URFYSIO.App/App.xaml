<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:URFYSIO.App"
             xmlns:converters="clr-namespace:URFYSIO.App.Converters"
             x:Class="URFYSIO.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:FutureDateConverter x:Key="FutureDateConverter" />
            <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
            <converters:IsActiveToTextDecorationConverter x:Key="IsActiveToTextDecorationConverter" />
            <converters:AllTrueConverter x:Key="AllTrueConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
