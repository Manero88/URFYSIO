<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:URFYSIO.App.ViewModels"
             x:Class="URFYSIO.App.Views.AppointmentsPage"
             x:DataType="vm:AppointmentsViewModel"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Logout"
                     Command="{Binding LogoutCommand, Source={x:Static vm:AppShellViewModel.Instance}}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="20" RowSpacing="10">

        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}" FontSize="12"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />
            <Label Text="{Binding SuccessMessage}"
                   TextColor="{StaticResource Success}"
                   FontSize="14"
                   IsVisible="{Binding SuccessMessage, Converter={StaticResource IsNotNullConverter}}"
                   Margin="0,5" />

            <!--
                Client-only informational notice. Cancel and Reschedule buttons still
                work — this is just a hint that the recommended flow is to coordinate
                with the physio first (e.g. for short-notice cancels). Hidden for
                physios/admins because they're the ones the client would contact.
            -->
            <Border IsVisible="{Binding IsClient}"
                    Padding="10" StrokeShape="RoundRectangle 6"
                    BackgroundColor="{StaticResource SurfaceBackground}"
                    Stroke="{StaticResource Primary}" StrokeThickness="1">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="&#x2139;" FontSize="16"
                           TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="To modify or cancel an appointment, please contact your physiotherapist."
                           FontSize="12" FontAttributes="Italic"
                           TextColor="{StaticResource TextSecondary}"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Admin management filter: all appointments, or narrowed to a single
                 physiotherapist / client. Only rendered for admins. -->
            <VerticalStackLayout Spacing="6" IsVisible="{Binding IsAdmin}">
                <Label Text="Filter appointments" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                <Picker ItemsSource="{Binding FilterModes}"
                        SelectedItem="{Binding SelectedFilterMode, Mode=TwoWay}" />
                <Picker Title="Choose a physiotherapist..."
                        ItemsSource="{Binding FilterPhysios}"
                        ItemDisplayBinding="{Binding FullName}"
                        SelectedItem="{Binding FilterPhysio, Mode=TwoWay}"
                        IsVisible="{Binding ShowPhysioFilter}" />
                <Picker Title="Choose a client..."
                        ItemsSource="{Binding FilterClients}"
                        ItemDisplayBinding="{Binding FullName}"
                        SelectedItem="{Binding FilterClient, Mode=TwoWay}"
                        IsVisible="{Binding ShowClientFilter}" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- Tab toggle: Upcoming / History -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Grid.Column="0" Text="Upcoming"
                    Command="{Binding ShowUpcomingCommand}"
                    CornerRadius="8" HeightRequest="40">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowHistory}" Value="False">
                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowHistory}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Gray200}" />
                        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="1" Text="History"
                    Command="{Binding ShowPastCommand}"
                    CornerRadius="8" HeightRequest="40">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowHistory}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowHistory}" Value="False">
                        <Setter Property="BackgroundColor" Value="{StaticResource Gray200}" />
                        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <!-- Upcoming appointments -->
        <RefreshView Grid.Row="2" Command="{Binding LoadAppointmentsCommand}"
                     IsRefreshing="{Binding IsBusy}"
                     IsVisible="{Binding ShowHistory, Converter={StaticResource InvertedBoolConverter}}">
            <CollectionView ItemsSource="{Binding UpcomingAppointments}"
                            EmptyView="No upcoming appointments.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:Object">
                        <Border Margin="0,5" Padding="12" StrokeShape="RoundRectangle 8">
                            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10">
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding StartTime, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                       FontAttributes="Bold" />
                                <Label Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                       Text="{Binding Status}" FontSize="12"
                                       TextColor="{StaticResource Primary}" />
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                       Text="{Binding PhysiotherapistName, StringFormat='Physio: {0}'}"
                                       FontSize="13" TextColor="{StaticResource TextSecondary}" />
                                <!-- Client name matters for physios/admins overseeing many
                                     clients; for a client it's their own name — hidden. -->
                                <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                       Text="{Binding ClientName, StringFormat='Client: {0}'}"
                                       FontSize="13" TextColor="{StaticResource TextSecondary}"
                                       IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:AppointmentsViewModel}}, Path=IsClient, Converter={StaticResource InvertedBoolConverter}}" />
                                <Label Grid.Row="3" Grid.Column="0"
                                       Text="{Binding Notes}" FontSize="12"
                                       TextColor="{StaticResource TextMuted}"
                                       LineBreakMode="TailTruncation" />
                                <!-- Reschedule/Cancel are physio/admin actions only. Clients
                                     see the "contact your physiotherapist" notice instead;
                                     the buttons are hidden for them and the API rejects
                                     client cancel/reschedule even if called directly. -->
                                <Button Grid.Row="3" Grid.Column="1"
                                        Text="Reschedule" FontSize="11"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AppointmentsViewModel}}, Path=RescheduleAppointmentCommand}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:AppointmentsViewModel}}, Path=IsClient, Converter={StaticResource InvertedBoolConverter}}"
                                        BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
                                        Padding="5,0" />
                                <Button Grid.Row="3" Grid.Column="2"
                                        Text="Cancel" FontSize="11"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AppointmentsViewModel}}, Path=CancelAppointmentCommand}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:AppointmentsViewModel}}, Path=IsClient, Converter={StaticResource InvertedBoolConverter}}"
                                        BackgroundColor="Transparent" TextColor="{StaticResource Error}"
                                        Padding="5,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Past / history appointments -->
        <RefreshView Grid.Row="2" Command="{Binding LoadAppointmentsCommand}"
                     IsRefreshing="{Binding IsBusy}"
                     IsVisible="{Binding ShowHistory}">
            <CollectionView ItemsSource="{Binding PastAppointments}"
                            EmptyView="No past appointments.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:Object">
                        <Border Margin="0,5" Padding="12" StrokeShape="RoundRectangle 8" Opacity="0.7">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10">
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding StartTime, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                       FontAttributes="Bold" />
                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding Status}" FontSize="12"
                                       TextColor="{StaticResource TextMuted}" />
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding PhysiotherapistName, StringFormat='Physio: {0}'}"
                                       FontSize="13" TextColor="{StaticResource TextSecondary}" />
                                <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding ClientName, StringFormat='Client: {0}'}"
                                       FontSize="13" TextColor="{StaticResource TextSecondary}"
                                       IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:AppointmentsViewModel}}, Path=IsClient, Converter={StaticResource InvertedBoolConverter}}" />
                                <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding Notes}" FontSize="12"
                                       TextColor="{StaticResource TextMuted}"
                                       LineBreakMode="TailTruncation" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Button Grid.Row="3" Text="Book New Appointment"
                Command="{Binding BookAppointmentCommand}"
                HeightRequest="48" />
    </Grid>
</ContentPage>
